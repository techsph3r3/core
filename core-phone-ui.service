[Unit]
Description=CORE Phone Sensor UI (Makau)
After=network.target core-web-ui.service

[Service]
Type=simple
User=meluallen
WorkingDirectory=/home/meluallen/makau_core/core-mcp-server
ExecStart=/usr/bin/python3 phone_web_ui.py --host 0.0.0.0 --port 8081 --auto-configure-injector --cert cert.pem --key key.pem
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
