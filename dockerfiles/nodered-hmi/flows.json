    {
        "id": "parse-inputs",
        "type": "function",
        "z": "sorting-hmi-flow",
        "name": "Parse Sensor Inputs",
        "func": "// PLC Outputs (Coils) - QX0.0 to QX0.7\n// Mapped from sorting_facility.st:\n// QX0.0: conveyor_run     - Conveyor motor running\n// QX0.1: diverter_red     - Red package diverter active\n// QX0.2: diverter_white   - White package diverter active\n// QX0.3: diverter_blue    - Blue package diverter active\n// QX0.4: alarm            - Alarm indicator\n// QX0.5: run_light        - System running indicator\n// QX0.6: fault_light      - Fault indicator\n// QX0.7: ready_light      - Ready indicator\n\nvar data = msg.payload;\n\nvar outputs = [\n    {topic: 'conveyor_running', payload: data[0]},   // QX0.0\n    {topic: 'diverter_red', payload: data[1]},       // QX0.1\n    {topic: 'diverter_white', payload: data[2]},     // QX0.2\n    {topic: 'diverter_blue', payload: data[3]},      // QX0.3\n    {topic: 'alarm', payload: data[4]},              // QX0.4\n    {topic: 'run_light', payload: data[5]},          // QX0.5\n    {topic: 'fault_light', payload: data[6]},        // QX0.6\n    {topic: 'ready_light', payload: data[7]}         // QX0.7\n];\n\nreturn outputs;",
        "outputs": 8,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 60,
        "wires": [
            ["led-conveyor"],
            ["led-diverter-red"],
            ["led-diverter-white"],
            ["led-diverter-blue"],
            ["led-alarm"],
            ["led-system"],
            ["led-fault"],
            ["led-ready"]
        ]
    },
    {
        "id": "parse-counters",
        "type": "function",
        "z": "sorting-hmi-flow",
        "name": "Parse Counters",
        "func": "// Holding Registers:\n// HR0: Red Count\n// HR1: White Count\n// HR2: Blue Count\n// HR3: Total Count\n// HR4: Conveyor Speed (0-100%)\n\nvar data = msg.payload;\n\nvar outputs = [\n    {topic: 'count_red', payload: data[0]},\n    {topic: 'count_white', payload: data[1]},\n    {topic: 'count_blue', payload: data[2]},\n    {topic: 'count_total', payload: data[3]},\n    {topic: 'conveyor_speed', payload: data[4]}\n];\n\nreturn outputs;",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 120,
        "wires": [
            ["gauge-red"],
            ["gauge-white"],
            ["gauge-blue"],
            ["gauge-total"],
            ["gauge-speed"]
        ]
    },
